#!/usr/bin/env bash
# bin/unauthscout
# Entry point for the UnauthScout tool

# Importing modules (Relative path to bin)
# Using 'dirname $0' ensures it works from any directory.
BASE_DIR=$(dirname "$(readlink -f "$0")")/..
source "${BASE_DIR}/lib/core.sh"
source "${BASE_DIR}/lib/gitlab_api.sh"
source "${BASE_DIR}/lib/github_api.sh"
source "${BASE_DIR}/lib/report.sh"

main() {
    local target=""
    local raw_mode=false
    local pretty_json=false
    local run_github=false
    local run_gitlab=false
    local fetch_repos=false
    local summarize=false
    
    # --- Dependency Validation (Core) --- 
    check_dependencies

    # --- Flag/argument handling ---
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --raw)          raw_mode=true; shift ;;
            --pretty)       pretty_json=true; shift ;;
            --github|-gh)   run_github=true; shift ;;
            --gitlab|-gl)   run_gitlab=true; shift ;;
            --repos|-r)     fetch_repos=true; shift ;;
            --summarize|-s) summarize=true; shift ;;
            -v|--version)   show_version; exit 0 ;;
            -h|--help)      show_help; exit 0 ;;
            -*)             die "Option unknown: $1 (Try --help)" ;;
            *)              target="$1"; shift ;;
        esac
    done

    [[ "$pretty_json" == true ]] && set_pretty_mode

    [[ -z "$target" ]] && show_help && exit 0
    if [[ "$run_github" == false && "$run_gitlab" == false ]]; then
        run_github=true; run_gitlab=true
    fi

    log_info "Starting scout on target: ${CLR_SUCCESS}${target}${CLR_RESET}"
    echo "------------------------------------------------------------"

    # --- Fluxo GitLab ---
    if [[ "$run_gitlab" == true ]]; then
        log_info "Searching on GitLab..."
        local raw_gl=$(get_gitlab_user_raw "$target")

        if [[ -n "$raw_gl" && "$raw_gl" != "[]" ]]; then
            local normalized_gl_user=$(echo "$raw_gl" | normalize_gitlab_user)
            
            if [[ "$raw_mode" == true ]]; then
                echo "$normalized_gl_user"
            else
                render_user_report "$normalized_gl_user"
            fi
            
            if [[ "$fetch_repos" == true ]]; then
                local repos_gl_norm=$(get_gitlab_repos_raw "$target" | normalize_gitlab_repos)
                
                if [[ "$raw_mode" == true ]]; then
                    echo "$repos_gl_norm"
                else
                    echo "$repos_gl_norm" | render_repos_list
                    [[ "$summarize" == true ]] && echo "$repos_gl_norm" | render_intel_summary
                fi
            fi
        else
            log_warn "GitLab: Target not found or private."
        fi
        echo -e "\n------------------------------------------------------------"
    fi

    # --- Fluxo GitHub ---
    if [[ "$run_github" == true ]]; then
        log_info "Searching on GitHub..."
        local raw_gh=$(get_github_user_raw "$target")

        if [[ -n "$raw_gh" ]]; then
            local normalized_gh_user=$(echo "$raw_gh" | normalize_github_user)
            
            if [[ "$raw_mode" == true ]]; then
                echo "$normalized_gh_user"
            else
                render_user_report "$normalized_gh_user"
            fi

            if [[ "$fetch_repos" == true ]]; then
                local repos_gh_norm=$(get_github_repos_raw "$target" | normalize_github_repos)
                
                if [[ "$raw_mode" == true ]]; then
                    echo "$repos_gh_norm"
                else
                    echo "$repos_gh_norm" | render_repos_list
                    [[ "$summarize" == true ]] && echo "$repos_gh_norm" | render_intel_summary
                fi
            fi
        else
            log_warn "GitHub: Target not found."
        fi
        echo -e "\n------------------------------------------------------------"
    fi

    log_success "Scout operation finished for: $target"
}

main "$@"
