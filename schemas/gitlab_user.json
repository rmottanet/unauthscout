{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitLabUser",
  "type": "object",
  "required": [
    "id",
    "username",
    "name",
    "state",
    "web_url"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique GitLab user identifier"
    },
    "username": {
      "type": "string",
      "description": "GitLab username (handle)"
    },
    "name": {
      "type": ["string", "null"],
      "description": "Display name"
    },
    "state": {
      "type": "string",
      "enum": ["active", "blocked"],
      "description": "Account state"
    },
    "web_url": {
      "type": "string",
      "format": "uri",
      "description": "Public profile URL"
    }
  },
  "additionalProperties": false
}
